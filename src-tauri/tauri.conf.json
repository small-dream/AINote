{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "MyNote",
  "version": "0.1.0",
  "identifier": "dev.mynote.app",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "pnpm dev",
    "beforeBuildCommand": "pnpm build"
  },
  "app": {
    "windows": [
      {
        "title": "MyNote",
        "width": 1200,
        "height": 800,
        "minWidth": 800,
        "minHeight": 600
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [],
    "macOS": {
      "entitlements": "entitlements/macOS.plist",
      "signingIdentity": "-"
    }
  }
}
